# Copie este arquivo para ".env" (mesma pasta do app.py) e preencha.
# Sem aspas. Barras invertidas do caminho de rede funcionam normalmente.

# Chave da API (platform.openai.com > API keys). Deixe vazio para MODO DEMO.
OPENAI_API_KEY=

# Modelos
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
LLM_MODEL=gpt-4o-mini

# Planilha na rede interna (caminho UNC ou unidade mapeada)
VISITAS_XLSX=\\SERVIDOR\Comercial\Visitas\visitas.xlsx
# VISITAS_XLSX=V:\Comercial\Visitas\visitas.xlsx

# Onde guardar os áudios originais (pode ser na rede também)
AUDIO_DIR=\\SERVIDOR\Comercial\Visitas\audios

# Aba coordenador e lista de vendedores (o 1º item é o "Selecione...")
COORD_SENHA=trocar
VENDEDORES=Selecione...,Eduardo (teste),Vendedor 1,Vendedor 2
