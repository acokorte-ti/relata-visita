# Copie este arquivo para ".env" (na raiz do repositório) e preencha.
# Sem aspas. Barras invertidas do caminho de rede funcionam normalmente.

# Chave da API (platform.openai.com > API keys). Deixe vazio para MODO DEMO.
OPENAI_API_KEY=

# Modelos
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
LLM_MODEL=gpt-4o-mini

# Banco de dados. Vazio = SQLite local em dados\relata.db (desenvolvimento).
# Produção (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://relata:SENHA@localhost:5432/relata_visita
DATABASE_URL=

# Onde guardar os áudios originais (pode ser na rede). Vazio = dados\audios
AUDIO_DIR=

# Chave que assina o login (cookie). Gere uma com:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sem ela, todo reinício do servidor desloga todo mundo.
SECRET_KEY=

# Dias que o vendedor fica logado no celular
SESSAO_DIAS=30

# 1 em produção (HTTPS). 0 para testar em http://localhost
COOKIE_SEGURO=0
